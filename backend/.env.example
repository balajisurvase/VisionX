# ==============================================================================
# SIH 2026 Problem Statement 26188: Backend Environment Variables
# Organization: Sashastra Seema Bal (SSB), Ministry of Home Affairs
# ==============================================================================

# Google Gemini API Key (Server-side vision engine for OCR, Forensics, Biometrics)
# Never expose to client browser. Get key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase PostgreSQL & Storage Configuration
# Service-role key has admin privileges and is strictly used server-side
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Security & JWT Session
JWT_SECRET=ssb-sih2026-secret-key-replace-in-production-sha256
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
MAX_UPLOAD_SIZE_MB=10
